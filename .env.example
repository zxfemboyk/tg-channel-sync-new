# Токен бота, который ты получил от @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Необязательно: username канала без @ (например "mychannel").
# Если указать — сайт будет принимать посты только из этого канала,
# даже если бот добавлен администратором в несколько каналов.
CHANNEL_USERNAME=

# Порт сервера (Render подставит свой автоматически, локально можно оставить 3000)
PORT=3000

# Необязательно: твой личный chat id в Telegram.
# Нужен для отслеживания удалённых в канале постов (чтобы они пропадали и с сайта).
# Как узнать: напиши своему боту /start в личных сообщениях — он пришлёт этот id.
ADMIN_CHAT_ID=
